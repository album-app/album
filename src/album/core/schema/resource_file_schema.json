{
  "$ref": "#/definitions/ResourceFile",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ResourceFile": {
      "type": "object",
      "properties": {
        "resources": {
          "title": "resources",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Resource"
          }
        }
      },
      "required": ["resources"]
    },
    "Resource": {
      "type": "object",
      "properties": {
        "name": {
          "title": "name",
          "type": "string",
          "minLength": 1
        },
        "url": {
          "title": "url",
          "type": "string",
          "pattern": "^(https?|s?ftp|doi):"
        },
        "hash": {
          "title": "hash",
          "type": ["string", "null"],
          "pattern": "^([A-Za-z0-9_]+:)?[0-9A-Fa-f]+$"
        },
        "os": {
          "title": "os",
          "enum": ["linux", "win32", "darwin", null]
        },
        "scope": {
          "title": "scope",
          "enum": ["global", "catalog", "solution", null]
        }
      },
      "required": ["name", "url"]
    }
  }
}
